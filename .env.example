# ~/factory-core/.env — copy to .env (gitignored) and fill. NEVER commit, NEVER paste into chat.
# Referenced by name only. mcp.json / loop.sh read these from the environment.

# --- Treasury (Stripe) ---
# Use a RESTRICTED key (checkout + read scopes), NOT a full sk_live_.
# Run #1 deploys in TEST mode — a pk_test_/sk_test_ pair is enough until the publish+charge gate is approved.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=          # pk_ — public by design, used client-side in checkout

# --- Compute offload (OpenRouter) ---
# Free tier covers the 6h heartbeat at $0 (50 req/day, no card). Used ONLY for heartbeats, not the build.
OPENROUTER_API_KEY=

# --- Notifications (reuse OpenClaw's existing bot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Media (Higgsfield) ---
# NO KEY NEEDED. Higgsfield is OAuth-only (verified). The CLI is already authed via `higgsfield auth login`.
# (intentionally left blank — do not add a key here)

# --- The publish+charge gate ---
# A one-time token the founder sends via Telegram to authorize flipping the live storefront to real charges.
# The deploy guard refuses live Stripe env unless this matches.
PUBLISH_APPROVAL_TOKEN=

# --- Resource thresholds (heartbeat usage.mjs reads + analyzes BOTH pools) ---
# Claude is your Max SUBSCRIPTION (OAuth) — builds bill $0 per-token; the real limit is plan rate
# limits, not a cash balance. usage.mjs reports consumption as an API-equivalent $ PROXY. Leave these
# UNSET to report-only; set a plan-equiv $ number to hard-flag when a rolling window exceeds it.
CLAUDE_5H_BUDGET=
CLAUDE_WEEK_BUDGET=
# Higgsfield generation credits floor — heartbeat says HALT media below this (live-read from the CLI).
HIGGSFIELD_MIN_CREDITS=5
