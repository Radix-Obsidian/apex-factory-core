# ~/factory-core/.env — copy to .env (gitignored) and fill. NEVER commit, NEVER paste into chat.
# Referenced by name only. mcp.json / loop.sh read these from the environment.

# --- Factory agent auth (Claude Code "staff" identity) — the FACTORY half of the two-key model ---
# The factory's OWN DEDICATED `claude setup-token` OAuth token (sk-ant-oat01-...). The loop's `claude`
# agents authenticate from this — web search, build, design, test — billed to the subscription it belongs
# to ($0/token), separate from your interactive Max session. One-year token; rotate via `claude setup-token`.
# IMPORTANT: ANTHROPIC_API_KEY/ANTHROPIC_AUTH_TOKEN OUTRANK this token, so loop.sh unsets them before calling
# claude. The SKU API key (sk-ant-api03-...) is SKU-ONLY — it runs shipped SKUs (per-token, in their Railway
# env), and must NEVER appear in this file. `auth-guard.sh` hard-fails the loop if it (or a non-oat01 token) does.
CLAUDE_CODE_OAUTH_TOKEN=
# Loop model — audited lineup (MODELS.md). Default Sonnet 4.6; set claude-opus-4-8 (or claude-fable-5) to escalate a hard build.
LOOP_MODEL=claude-sonnet-4-6
# Loop hardening for unattended overnight runs. ITER_TIMEOUT = max seconds per iteration (needs `timeout`/
# `gtimeout` — brew install coreutils); MAX_FAILS = consecutive failures before the circuit breaker stops + alerts.
ITER_TIMEOUT=1800
MAX_FAILS=3
# Loop isolation (D12): the autonomous loop runs in its OWN git worktree + branch so it never shares a
# working tree/index with founder sessions on `main`. Defaults work out of the box (nested .worktrees/loop,
# gitignored). Override LOOP_WORKTREE to a sibling/external path for an enterprise multi-checkout layout.
LOOP_WORKTREE=
LOOP_BRANCH=loop/auto

# --- Treasury (Stripe) ---
# Use a RESTRICTED key (checkout + read scopes), NOT a full sk_live_.
# Run #1 deploys in TEST mode — a pk_test_/sk_test_ pair is enough until the publish+charge gate is approved.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=          # pk_ — public by design, used client-side in checkout

# --- Preview deploy (D17) ---
# deploy-guard.sh preview runs DEPLOY_CMD (and refuses any sk_live_ key in preview). Unset = dry-run only.
# Vercel is simplest for a Next.js SKU preview (zero-config, free tier); Railway is the alternative (preflight checks it).
# Point it at the per-SKU repo (D4 — each SKU is its own repo, separate from this control plane). Examples:
#   DEPLOY_CMD="cd ../<sku-repo> && vercel --yes"        # Vercel (recommended for Next.js)
#   DEPLOY_CMD="cd ../<sku-repo> && railway up"          # Railway
DEPLOY_CMD=

# --- Design system (D18) ---
# No env var. Each SKU ships an intentional brand kit authored via Claude Design + the `/design-sync` skill,
# synced as a `design-system/` folder of `@dsCard`-tagged HTML cards. Validate structure (deterministic, $0):
#   make design-check SKU=../<sku-repo>

# --- Compute offload (OpenRouter) ---
# Free tier covers the 6h heartbeat at $0 (50 req/day, no card). Used ONLY for heartbeats, not the build.
OPENROUTER_API_KEY=

# --- Notifications (reuse OpenClaw's existing bot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Media (Higgsfield) ---
# NO KEY NEEDED. Higgsfield is OAuth-only (verified). The CLI is already authed via `higgsfield auth login`.
# (intentionally left blank — do not add a key here)

# --- The publish+charge gate ---
# A one-time token the founder sends via Telegram to authorize flipping the live storefront to real charges.
# The deploy guard refuses live Stripe env unless this matches.
PUBLISH_APPROVAL_TOKEN=

# --- Resource thresholds (heartbeat usage.mjs reads + analyzes BOTH pools) ---
# Claude is your Max SUBSCRIPTION (OAuth) — builds bill $0 per-token; the real limit is plan rate
# limits, not a cash balance. usage.mjs reports consumption as an API-equivalent $ PROXY. Leave these
# UNSET to report-only. SET a plan-equiv $ number to (a) hard-flag in the heartbeat AND (b) ARM the
# in-loop allowance gate: `usage.mjs --claude-gate` cools the loop down instead of burst-firing through
# a rate limit. Example starting points (tune to your Max tier): CLAUDE_5H_BUDGET=120  CLAUDE_WEEK_BUDGET=2000
CLAUDE_5H_BUDGET=
CLAUDE_WEEK_BUDGET=
# Higgsfield generation credits floor — heartbeat says HALT media below this (live-read from the CLI).
HIGGSFIELD_MIN_CREDITS=5
