{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skus/registry",
  "title": "SkuRegistry",
  "description": "D20 — the SKU portfolio the post-launch operate loop iterates. The deterministic validator in ops/registry.mjs enforces a subset of this (no schema lib in the factory); this file is the canonical contract.",
  "type": "object",
  "required": ["version", "skus"],
  "additionalProperties": true,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "updated": { "type": "string" },
    "note": { "type": "string" },
    "skus": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "name", "status", "repo"],
        "additionalProperties": true,
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string" },
          "domain": { "type": "string" },
          "status": { "type": "string", "enum": ["staged", "live", "paused", "killed"] },
          "repo": { "type": "string" },
          "local_path": { "type": "string" },
          "live_url": { "type": "string" },
          "deploy": {
            "type": "object",
            "properties": { "target": { "type": "string" }, "service": { "type": "string" } }
          },
          "health": {
            "type": "object",
            "properties": { "path": { "type": "string" }, "slow_ms": { "type": "integer", "minimum": 1 } }
          },
          "billing": {
            "type": "object",
            "required": ["provider"],
            "properties": {
              "provider": { "type": "string", "enum": ["stripe", "none"] },
              "mode": { "type": "string", "enum": ["test", "live"] },
              "model": { "type": "string" },
              "price_usd": { "type": "number" },
              "secret_env": {
                "type": "string",
                "description": "NAME of an env var holding a read-only restricted key — never the key itself.",
                "not": { "pattern": "sk_(live|test)_" }
              }
            }
          },
          "support": {
            "type": "object",
            "properties": {
              "source": { "type": "string", "enum": ["inbox-file", "endpoint", "none"] },
              "inbox": { "type": "string" },
              "from": { "type": "string" }
            }
          },
          "owning_agents": { "type": "array", "items": { "type": "string" } },
          "pending_founder_actions": { "type": "array", "items": { "type": "string" } },
          "created": { "type": "string" }
        }
      }
    }
  }
}
